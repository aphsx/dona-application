# Server-only: Next.js proxies /api/v1/* to this origin.
# Do NOT expose secrets with NEXT_PUBLIC_ — browser talks to same-origin /api/v1.
DONA_API_URL=http://127.0.0.1:8080

# Optional listen port (defaults used by npm scripts if unset)
PORT=3001

# Server-only: avatar upload → Supabase Storage (public bucket `avatars`)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# production example:
# NODE_ENV=production
# DONA_API_URL=https://api.example.com
# PORT=3001
